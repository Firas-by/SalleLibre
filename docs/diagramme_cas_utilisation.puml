@startuml SalleLibre_Use_Cases
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 8

actor "Visiteur / Non-connecté" as V
actor "Étudiant Connecté" as E
actor "Administrateur Scolarité" as A
actor "Système (Scheduler)" as S

E --|> V

rectangle "Système SalleLibre 2.0" {
  package "Consultation & Guidage" {
    usecase "UC1: Consulter l'onboarding et choisir la langue" as UC1
    usecase "UC2: Consulter les salles libres en temps réel" as UC2
    usecase "UC3: Filtrer par bâtiment, capacité et prises" as UC3
    usecase "UC4: Visualiser la recommandation 'Meilleur Choix'" as UC4
    usecase "UC5: Consulter la carte interactive des étages" as UC5
    usecase "UC6: Consulter le cache hors-ligne" as UC6
  }

  package "Crowdsourcing & Entraide" {
    usecase "UC7: S'authentifier (Email institutionnel)" as UC7
    usecase "UC8: Signaler l'état réel et l'ambiance sonore" as UC8
    usecase "UC9: Vérifier le quota anti-spam 10 min" as UC9
    usecase "UC10: Lancer une session d'entraide (Study Beacon)" as UC10
    usecase "UC11: Rejoindre une session d'étude collaborative" as UC11
  }

  package "Administration & Gouvernance" {
    usecase "UC12: Importer l'emploi du temps CSV" as UC12
    usecase "UC13: Rejeter fichier erroné avec numéro de ligne" as UC13
    usecase "UC14: Consulter la heatmap d'affluence campus" as UC14
  }

  package "Traitements Automatisés" {
    usecase "UC15: Dégrader état vers INCERTAINE (> 30 min)" as UC15
    usecase "UC16: Anonymiser les signalements (> 24h)" as UC16
    usecase "UC17: Mettre à jour le Campus Karma" as UC17
  }
}

V --> UC1
V --> UC2
V --> UC3
V --> UC4
V --> UC5
V --> UC6
V --> UC7

E --> UC8
E --> UC10
E --> UC11

UC8 ..> UC9 : <<include>>
UC12 ..> UC13 : <<extend>>

A --> UC7
A --> UC12
A --> UC14

S --> UC15
S --> UC16
S --> UC17

@enduml
